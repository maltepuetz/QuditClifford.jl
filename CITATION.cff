    given-names: Malte
    affiliation: University of Cologne
    orcid: "https://orcid.org/0009-0009-0327-5644"
repository-code: "https://github.com/maltepuetz/QuditClifford.jl"
url: "https://maltepuetz.github.io/QuditClifford.jl/"
license: MIT
doi: 10.5281/zenodo.24170577
keywords:
  - Julia
  - qudits
  - Clifford circuits
  - stabilizer formalism
  - quantum simulation
  - quantum information
